## SICE ####

sice_categorical <- function(data, m = 5, method_in_mice) {
  #' SICE-Categorical Implementation
  
  # Identify rows with missing values (x) and columns containing missing values
  missing_rows <- which(!complete.cases(data))
  missing_cols <- names(data)[colSums(is.na(data)) > 0]
  
  if (length(missing_rows) == 0) {
    message("No missing values found in the dataset.")
    return(data)
  }
  
  # Run MICE m times
  imp <- mice(data, m = m, method = method_in_mice, printFlag = FALSE)
  
  # Helper function to find the statistical mode for categorical data
  get_mode <- function(v) {
    v <- as.character(v)
    uniqv <- unique(v)
    uniqv[which.max(tabulate(match(v, uniqv)))]
  }
  
  # Copy dataset to store updated results (x')
  data_updated <- data
  
  # For each missing row/value, extract m results and compute Mode
  for (r in missing_rows) {
    for (col in missing_cols) {
      if (is.na(data[r, col])) {
        
        # Extract the imputed value for this specific cell across all m datasets
        imputed_values <- sapply(1:m, function(i) {
          completed_df <- complete(imp, i)
          completed_df[r, col]
        })
        
        # Calculate Mode of the m imputations (SICEResult)
        modal_val <- get_mode(imputed_values)
        
        # Convert back to factor level if necessary
        if (is.factor(data[, col])) {
          modal_val <- factor(modal_val, levels = levels(data[, col]))
        }
        
        # Update dataset with SICEResult
        data_updated[r, col] <- modal_val
      }
    }
  }
  
  return(data_updated)
}

sice_numeric <- function(data, m = 7, method_in_mice) {
  #' SICE-Categorical Implementation
  
  # Identify rows with missing values (x) and columns containing missing values
  missing_rows <- which(!complete.cases(data))
  missing_cols <- names(data)[colSums(is.na(data)) > 0]
  
  if (length(missing_rows) == 0) {
    message("No missing values found in the dataset.")
    return(data)
  }
  
  # Run MICE m times
  imp <- mice(data, m = m, method = method_in_mice, printFlag = FALSE)
  
  completed_list <- complete(imp, action = "all")
  
  # Copy dataset to store updated results
  data_updated <- data
  
  # 3. Fast loop querying the pre-extracted list
  for (r in missing_rows) {
    for (col in missing_cols) {
      if (is.na(data[r, col])) {
        
        # Pull the value from each completed dataset in the list (blazing fast)
        imputed_values <- sapply(1:m, function(i) {
          completed_list[[i]][r, col]
        })
        
        # Calculate mean
        mean_val <- mean(as.numeric(imputed_values), na.rm = TRUE)
        
        # Update dataset
        data_updated[r, col] <- mean_val
      }
    }
  }
  
  return(data_updated)
}
